{
  // Node에서 도는 설정 파일과 E2E(vite.config.ts, playwright.config.ts, e2e). 화면 코드에 node 타입이 섞이지 않게 따로 본다.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
