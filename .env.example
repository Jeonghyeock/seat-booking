# 앱이 접속하는 role(슈퍼유저 아님, 테스트 DB 복제를 위해 CREATEDB만). 만드는 법은 README.
DATABASE_URL=postgres://seat_booking:비밀번호@127.0.0.1:5432/seat_booking
# PORT=3001
# 가짜 결제사 웹훅 서명 비밀. 없으면 서버를 띄울 때마다 무작위로 만든다.
# FAKE_PAY_SECRET=
# 화면의 origin(쉼표로 여럿, 끝에 / 없이). 개발은 Vite 프록시라 화면 주소다(DESIGN 6.3 배치).
APP_ORIGIN=http://localhost:5173
# http로 도는 개발 서버는 false(쿠키 이름 sid). 운영은 true(__Host-sid).
COOKIE_SECURE=false
# 가입·로그인 분당 허용 수(IP당, 로그인은 IP+이메일). 기본 10.
# AUTH_RATE_LIMIT_PER_MINUTE=10
