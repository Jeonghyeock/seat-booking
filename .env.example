# 앱(서버, admin:promote)이 접속하는 role(DML만). 만드는 법은 README.
DATABASE_URL=postgres://seat_booking_app:비밀번호@127.0.0.1:5432/seat_booking
# 마이그레이션·시드·테스트와 E2E·부하 준비가 접속하는 소유자 role(표의 주인, 테스트 DB 복제를 위해 CREATEDB).
DATABASE_OWNER_URL=postgres://seat_booking:비밀번호@127.0.0.1:5432/seat_booking
# PORT=3001
# 가짜 결제사 웹훅 서명 비밀. 없으면 서버를 띄울 때마다 무작위로 만든다.
# FAKE_PAY_SECRET=
# 화면의 origin(쉼표로 여럿, 끝에 / 없이). 개발은 Vite 프록시라 화면 주소다(DESIGN 6.3 배치).
APP_ORIGIN=http://localhost:5173
# http로 도는 개발 서버는 false(쿠키 이름 sid). 운영은 true(__Host-sid).
COOKIE_SECURE=false
# 가입·로그인 분당 허용 수(가입은 IP당, 로그인은 IP+이메일당. 로그인은 IP 하나로도 그 10배까지). 기본 10.
# AUTH_RATE_LIMIT_PER_MINUTE=10
# 리버스 프록시 뒤에서 띄울 때만. 믿을 프록시의 주소·CIDR(쉼표로 여럿). true와 숫자는 받지 않는다.
# TRUST_PROXY=127.0.0.1
# 업무 이벤트 릴레이(npm run outbox:relay, DESIGN 6.8)가 보내는 분석 프로젝트(event-analytics)의 주소와 쓰기 키.
# EVENT_ANALYTICS_URL=http://127.0.0.1:3002
# EVENT_ANALYTICS_WRITE_KEY=
